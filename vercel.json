{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/.netlify/functions/:fn", "destination": "/api/:fn" }
  ],
  "functions": {
    "api/[fn].js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cleanup", "schedule": "20 5 * * *" },
    { "path": "/api/campaign-creator", "schedule": "*/5 * * * *" }
  ]
}
